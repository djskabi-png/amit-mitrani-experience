rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'amitmagician6@gmail.com'
        ];
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'phone', 'email', 'interest', 'product', 'date', 'country',
        'city', 'participants', 'message', 'requestType', 'requestNumber',
        'status', 'notificationStatus', 'source', 'medium', 'campaign',
        'content', 'term', 'referrer', 'landingPage', 'formPage',
        'utmParameters', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 2
      && request.resource.data.name.size() <= 100
      && request.resource.data.phone is string
      && request.resource.data.phone.size() >= 7
      && request.resource.data.phone.size() <= 30
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 180
      && request.resource.data.interest is string
      && request.resource.data.interest.size() >= 2
      && request.resource.data.interest.size() <= 120
      && request.resource.data.message is string
      && request.resource.data.message.size() <= 1500
      && request.resource.data.requestType in ['booking_request', 'contact_request']
      && request.resource.data.status == 'pending'
      && request.resource.data.notificationStatus == 'not_configured'
      && request.resource.data.source is string
      && request.resource.data.source.size() <= 500
      && (!request.resource.data.keys().hasAny(['medium'])
        || (request.resource.data.medium is string && request.resource.data.medium.size() <= 120))
      && (!request.resource.data.keys().hasAny(['campaign'])
        || (request.resource.data.campaign is string && request.resource.data.campaign.size() <= 200))
      && (!request.resource.data.keys().hasAny(['content'])
        || (request.resource.data.content is string && request.resource.data.content.size() <= 300))
      && (!request.resource.data.keys().hasAny(['term'])
        || (request.resource.data.term is string && request.resource.data.term.size() <= 300))
      && (!request.resource.data.keys().hasAny(['referrer'])
        || (request.resource.data.referrer is string && request.resource.data.referrer.size() <= 1000))
      && (!request.resource.data.keys().hasAny(['landingPage'])
        || (request.resource.data.landingPage is string && request.resource.data.landingPage.size() <= 1000))
      && (!request.resource.data.keys().hasAny(['formPage'])
        || (request.resource.data.formPage is string && request.resource.data.formPage.size() <= 1000))
      && (!request.resource.data.keys().hasAny(['utmParameters'])
        || (request.resource.data.utmParameters is string && request.resource.data.utmParameters.size() <= 2000))
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /siteContent/{pageId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'pagePath', 'payload', 'draftPayload', 'previousPayload', 'history',
          'updatedAt', 'updatedBy', 'draftUpdatedAt', 'draftUpdatedBy',
          'publishedAt', 'publishedBy'
        ])
        && request.resource.data.keys().hasAll([
          'pagePath', 'payload', 'draftPayload', 'previousPayload', 'history',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() <= 500
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 850000
        && request.resource.data.draftPayload is string
        && request.resource.data.draftPayload.size() <= 850000
        && request.resource.data.previousPayload is string
        && request.resource.data.previousPayload.size() <= 850000
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 5
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email
        && (!request.resource.data.keys().hasAny(['draftUpdatedAt'])
          || request.resource.data.draftUpdatedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['draftUpdatedBy'])
          || request.resource.data.draftUpdatedBy == request.auth.token.email)
        && (!request.resource.data.keys().hasAny(['publishedAt'])
          || request.resource.data.publishedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['publishedBy'])
          || request.resource.data.publishedBy == request.auth.token.email);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
